<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:id="@+id/layoutReady"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <com.example.myapplication.FluidClockView
            android:id="@+id/fluid_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/fieldContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/imgField"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_football_field"
                app:tint="#888888"/>

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/overlayHome"
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent" />

                    <View
                        android:id="@+id/clickHomeColor"
                        android:layout_width="match_parent"
                        android:layout_height="114dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/overlayAway"
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent" />

                    <View
                        android:id="@+id/clickAwayColor"
                        android:layout_width="match_parent"
                        android:layout_height="114dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:id="@+id/rippleRing"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ripple_ring" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBigStart"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:text="@string/btn_start"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_btn_start_3d" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetMatchTime"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_above="@id/btnHistorySmall"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:text="45 min/half"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#2A2A2A"
            app:cornerRadius="16dp"
            app:strokeColor="#444444"
            app:strokeWidth="1dp" />

        <View
            android:id="@+id/btnHistorySmall"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="6dp"
            android:background="#666666" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layoutRunning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/touchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/timerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/mainTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4CAF50"
                android:textSize="56sp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stoppageTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="18sp"
                android:textColor="#888888"
                app:drawableStartCompat="@drawable/more_time"
                android:drawablePadding="4dp"
                android:drawableTint="#888888"
                android:background="@drawable/bg_stoppage_capsule"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:padding="6dp"
            android:background="#CC000000"
            android:translationY="200dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseRound"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cornerRadius="26dp"
                app:backgroundTint="#D32F2F"
                app:icon="@drawable/pause_circle"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndRound"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cornerRadius="26dp"
                android:background="@drawable/bg_end_button_progress_round"
                app:backgroundTint="@null"
                app:icon="@drawable/stop_circle"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>
    </RelativeLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/mainButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/endHalfButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</RelativeLayout>